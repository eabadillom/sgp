	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SGP_Azure.jrdax"/>
	<parameter name="idEmpresa" class="java.lang.Integer"/>
	<parameter name="idPlanta" class="java.lang.Integer"/>
	<parameter name="fecha" class="java.util.Date">
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="imagen" class="java.lang.String">
		<defaultValueExpression><![CDATA["./logo.png"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select
	de.num_empleado,
	de.nombre,
	de.primer_ap,
	de.segundo_ap,
	iee.fh_ingreso,
	ce.nb_razon_social,
	cp.descripcion
from det_empleado de
inner join inf_empleado_empresa iee on de.id_empleado_empresa = iee.id_empleado_empresa
left outer join cat_empresa ce on iee.id_empresa = ce.id_empresa
left outer join cat_planta cp on iee.id_planta = cp.id_planta
where ($P{idEmpresa} is null or ce.id_empresa = $P{idEmpresa})
and ($P{idPlanta} is null or cp.id_planta = $P{idPlanta})
and ( iee.fh_ingreso <= $P{fecha} and (iee.fh_baja is null or $P{fecha} <= iee.fh_baja))
order by ce.nb_razon_social, cp.descripcion, de.nombre, de.primer_ap, de.segundo_ap]]>
	</queryString>
